    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "~5.9.3",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3"
  },
  "engines": { "node": ">=22.18.0" }
}
